# Copier ce fichier en `.env` et renseigner les valeurs.
# Le fichier `.env` est exclu de git : il ne doit JAMAIS être versionné ni affiché.

# --- Projet Supabase (région européenne) ---
# Adresse du projet, de la forme https://<ref>.supabase.co
SUPABASE_URL=
# Identifiant du projet (la « project ref », 20 caractères, visible dans l'adresse du tableau de bord)
SUPABASE_PROJECT_REF=
# Clé publique (« Publishable key », commence par sb_publishable_) : celle que la page web utilise ;
# elle ne donne accès qu'à ce que les règles d'accès de la base autorisent. Sert aussi aux tests d'accès.
SUPABASE_PUBLISHABLE_KEY=
# Clé secrète (« Secret key », commence par sb_secret_) : passe outre les règles d'accès.
# Réservée aux scripts lancés sur l'ordinateur du responsable. Ne sort jamais de cet ordinateur.
SUPABASE_SECRET_KEY=
# Mot de passe de la base de données (Settings > Database) : utilisé par l'outil en ligne de commande pour les migrations.
SUPABASE_DB_PASSWORD=

# --- Hugging Face (facultatif : seulement si un jeu de données l'exige) ---
HF_TOKEN=
