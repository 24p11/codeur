# Copier ce fichier en `.env` et renseigner les valeurs.
# Le fichier `.env` est exclu de git : il ne doit JAMAIS être versionné ni affiché.

# Projet Supabase (région européenne)
SUPABASE_URL=
# Clé "service_role" : secrète, réservée aux scripts lancés sur l'ordinateur du responsable.
SUPABASE_SERVICE_ROLE_KEY=

# Jeton Hugging Face (facultatif : seulement si le jeu de données l'exige)
HF_TOKEN=
